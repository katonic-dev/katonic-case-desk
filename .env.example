# The regulatory change desk: settings. On Katonic, App Studio asks for these when
# you deploy the app (framework Node/React); locally, copy this file to .env.

# The platform. The key speaks for its owner; give it the Chat scope only.
KATONIC_BASE_URL=https://katonic.your-company.example
KATONIC_API_KEY=kapi_...

# The agent the desk hands each publication to: the published Regulatory
# Monitoring Agent (its id, not its slug). With the policy library attached as
# its knowledge source and a search server's tool attached.
KATONIC_AGENT_ID=
# The name of the policy library attached to that agent, recorded on every
# draft and in the register as what was compared against.
KATONIC_LIBRARY_NAME=Meridian policy library (invented)
# Optional. The library's source id: when set, the desk searches the library
# itself (key scope: Knowledge search) and hands the passages to the agent.
# Use it where the library cannot be attached to the agent.
KATONIC_LIBRARY_SOURCE_ID=

# Where the desk keeps its records. A PostgreSQL connection string when the
# platform provisions a database for the app; otherwise a folder. Locally the
# folder is ./data. On Katonic, do not set DATA_DIR: attach a Storage dataset
# to the app and the desk keeps its records on it.
DATABASE_URL=
DATA_DIR=./data

# Who is signed in. On the platform, the sign-in step in front of the app sets
# X-Forwarded-Email and friends; the desk believes them ONLY when this is "true",
# which is safe only where nothing can reach the app except through that step.
TRUST_SIGN_IN_HEADERS=false
# Stand-in identity for local runs (used when the headers are not trusted).
LOCAL_USER=officer@example.invalid
LOCAL_USER_NAME=Local officer

# A shared token the bank's regulatory feed sends as X-Intake-Token on
# POST /api/intake. Empty = intake by webhook is off.
INTAKE_TOKEN=

# Set by App Studio: PORT and PUBLIC_URL (the /apps/<name> path).
PORT=3000
PUBLIC_URL=
